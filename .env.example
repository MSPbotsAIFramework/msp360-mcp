# msp360-mcp has no required environment variables.
# Authentication is per-request via two headers:
#   X-Msp360-Username   MSP360 Managed Backup provider-account username,
#                       from the MSP360 admin portal -> Settings -> API credentials.
#   X-Msp360-Password   MSP360 Managed Backup provider-account password, same place.
# This server exchanges them for a bearer token internally (POST /api/Provider/Login) on
# demand and caches the token per credential fingerprint until it expires.
# Credentials are never read from the environment — see src/msp360_mcp/middleware.py.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
